# Theme and font. Each tape sets its own size after this. The window frame comes
# later, from ../frame, because vhs draws no window title.
Set Shell zsh
Set FontFamily "JetBrainsMono Nerd Font, JetBrains Mono, Menlo, monospace"
Set FontSize 18
Set Padding 20
Set TypingSpeed 45ms
# Atom, with the background of the Claude Code journal pane, so the pane and the terminal have one color.
Set Theme {"name": "Atom", "background": "#262626", "foreground": "#c5c8c6", "cursor": "#d0d0d0", "selection": "#444444", "black": "#000000", "red": "#fd5ff1", "green": "#87c38a", "yellow": "#ffd7b1", "blue": "#85befd", "magenta": "#b9b6fc", "cyan": "#85befd", "white": "#e0e0e0", "brightBlack": "#000000", "brightRed": "#fd5ff1", "brightGreen": "#94fa36", "brightYellow": "#f5ffa8", "brightBlue": "#96cbfe", "brightMagenta": "#b9b6fc", "brightCyan": "#85befd", "brightWhite": "#e0e0e0"}
