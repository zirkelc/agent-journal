# Theme and font. Each tape sets its own size after this. The window frame comes
# later, from ../frame, because vhs draws no window title.
Set Shell zsh
Set FontFamily "JetBrainsMono Nerd Font, JetBrains Mono, Menlo, monospace"
Set FontSize 18
Set Padding 20
Set TypingSpeed 45ms
# Atom One Light, with the background of the Claude Code journal pane in the light theme, so the pane and the terminal have one color.
Set Theme {"name": "AtomOneLight", "background": "#eeeeee", "foreground": "#2a2c33", "cursor": "#bbbbbb", "selection": "#d8d8d8", "black": "#000000", "red": "#de3e35", "green": "#3f953a", "yellow": "#d2b67c", "blue": "#2f5af3", "magenta": "#950095", "cyan": "#3f953a", "white": "#bbbbbb", "brightBlack": "#000000", "brightRed": "#de3e35", "brightGreen": "#3f953a", "brightYellow": "#d2b67c", "brightBlue": "#2f5af3", "brightMagenta": "#a00095", "brightCyan": "#3f953a", "brightWhite": "#ffffff"}
