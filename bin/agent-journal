#!/bin/sh
#
# The whole of agent-journal that is not prose.
#
#   agent-journal list    [filters]
#   agent-journal search  TEXT [filters]
#   agent-journal read    ID
#   agent-journal write   [-m SUMMARY]
#   agent-journal config  [set|unset <key> [value]]
#   agent-journal context [--cwd DIR] [--session-id ID]
#
# `context` prints the text a session should be given: INSTRUCTIONS.md,
# resolved against the settings and against where the session is.
# It prints plain text and knows nothing about any agent, which is the seam that
# lets one adapter per agent wrap it in whatever that agent reads.
#
# `config` reads and writes the settings, and is the only thing that knows the
# config file's syntax, so a shell, an installer and a model all go through it
# rather than each carrying a copy of the format.
#
# `list`, `search`, `read` and `write` are the human half. They are what a person
# has instead of remembering grep recipes, and they are the seam an index can sit
# behind later without any adapter noticing.
#
# POSIX sh and awk only. No runtime to install, and fast enough to sit in front
# of every session.

set -u

self=$0
case $self in
  */*) ;;
  *) self=./$self ;;
esac

# An installed copy is reached through a symlink, since `agent-journal` and `aj`
# both point here from a bin directory. Following them is what makes the root the
# checkout rather than that bin directory, which is where INSTRUCTIONS.md would
# otherwise be looked for and never found. Bounded, so a symlink that points at
# itself cannot hang a session.
links=0
while [ -L "$self" ] && [ "$links" -lt 32 ]; do
  links=$((links + 1))
  target=$(readlink "$self") || break
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done

root=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd) || root=

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/agent-journal/config"

# The shipped default, stated once. `config` reports it back as the effective
# value whenever the key is unset, and `config set` removes the key rather than
# writing it when the value matches, so changing it here reaches every install
# that never overrode it.
default_journal_dir=$HOME/agent-journal

help_text() {
  cat <<'EOF'
usage: agent-journal list   [filters]
       agent-journal search TEXT [filters]
       agent-journal read   latest | 2026-01-11T143000Z | 2026-01-11
       agent-journal write  [--summary S] [--body B] [--project P] [--cwd DIR]
       agent-journal config [set|unset journal_dir <path>]
       agent-journal context [--cwd DIR] [--session-id ID]
       agent-journal help

write takes the summary and the body as flags, and anything piped in is the
body. Without a summary it opens $EDITOR on a template, carrying any body it
already has. The project and the directory come from where you are unless the
flags say otherwise.

filters: --date D      a prefix of the timestamp: 2026, 2026-01, 2026-01-11
         --since D     from this day on, as YYYY-MM-DD, today, or 7d
         --until D     up to this day, same forms
         --project P   entries filed under one project
         --cwd DIR     entries from a directory and everything under it
         --limit N     how many of the most recent to print, default 20
         --all         no limit

settings: journal_dir    where journal entries are written

Entries are listed oldest first, so the newest is nearest the prompt.
EOF
}

# The same text, and the difference is who asked for it. A mistake belongs on
# stderr and has to fail, or a script would carry on as though it had worked;
# `agent-journal help` was asked for, so it belongs on stdout and succeeds, which
# is also what makes piping it into a pager work.
usage() {
  help_text >&2
  exit 2
}

show_help() {
  help_text
  exit 0
}

newline='
'

# ---------------------------------------------------------------- config

# One file decides where entries go. Flat `key=value`, one per line, `#`
# comments, read by shell and written by a setup script or a model, so it stays
# the simplest format both can handle without a parser.
#
# Unrecognised keys are ignored rather than rejected. A newer version writing a
# key this one has not heard of must not break the session, and the reverse has
# to hold too, because both will exist on the same machine during any upgrade.
cfg_journal_dir=

read_config() {
  [ -f "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      '' | '#'*) continue ;;
      *=*) ;;
      *) continue ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    key=${key% }
    key=${key# }
    value=${value# }
    value=${value% }

    case $key in
      journal_dir) cfg_journal_dir=$value ;;
    esac
  done < "$1"
}

# A config file is hand-editable, so a leading `~` is likely and expanding it
# costs less than the bug report.
expand_home() {
  case $1 in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s\n' "$HOME/${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# The inverse, for anything a human reads. Entries record `cwd` in this form,
# which is also the form every existing entry already uses.
abbrev_home() {
  case $1 in
    "$HOME") printf '~\n' ;;
    "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# The only thing that writes the config, so the format has one owner.
#
# Rewrites in place, keeping every line it is not changing: comments, blank
# lines, ordering, and keys it does not recognise all survive. Setting a key to
# its default deletes the line instead of writing it, so accepting a default
# never pins it.
write_config() {
  target=$1
  set_key=$2
  set_value=$3

  mkdir -p "$(dirname "$target")" || return 1
  tmp=$target.$$

  : > "$tmp" || return 1
  written=0

  # A file nobody has seen before gets a header saying what may go in it, since
  # the point of a plain text config is that opening it explains itself.
  if [ ! -f "$target" ]; then
    cat >> "$tmp" <<'EOF'
# agent-journal
#
# Written by `agent-journal config set`. Editing by hand works, but that command
# validates values and is what the setup and the slash command both use.
#
#   journal_dir    where journal entries are written
#
# Only settings that differ from the default are here. An absent key follows the
# default, which is how a changed default reaches you.

EOF
  fi

  if [ -f "$target" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case $line in
        '' | '#'*) printf '%s\n' "$line" >> "$tmp"; continue ;;
        *=*) ;;
        *) printf '%s\n' "$line" >> "$tmp"; continue ;;
      esac
      key=${line%%=*}
      key=${key% }
      key=${key# }
      if [ "$key" = "$set_key" ]; then
        # Replaced in place rather than appended, so a key keeps its position
        # and the file does not grow a second copy of itself over time.
        [ -z "$set_value" ] || printf '%s=%s\n' "$set_key" "$set_value" >> "$tmp"
        written=1
      else
        printf '%s\n' "$line" >> "$tmp"
      fi
    done < "$target"
  fi

  if [ "$written" = 0 ] && [ -n "$set_value" ]; then
    printf '%s=%s\n' "$set_key" "$set_value" >> "$tmp"
  fi

  mv "$tmp" "$target"
}

# ---------------------------------------------------------------- location

# The name a session's entries are filed under. It comes from the common git
# dir, never from the working tree's own root: a worktree's root is named after
# its branch, so `--show-toplevel` would file `nebula.worktrees/fix-auth` under
# `fix-auth` and scatter one repository across a project per branch. The common
# dir always points at the main repository, so every worktree agrees. It also
# collapses subdirectories and bare repositories.
#
# Storing entries inside a repository would be the other question, and would
# take the other answer: that is per-worktree content and would come from
# `--show-toplevel`. Nothing asks it yet.
resolve_project() {
  project=
  gitdir=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || gitdir=

  if [ -n "$gitdir" ]; then
    case $gitdir in
      */.git) gitdir=${gitdir%/.git} ;;
    esac
    project=${gitdir##*/}
    project=${project%.git}
  fi

  # Outside a repository there is no project, and the directory's own name is not
  # a substitute for one: it would file `Downloads` as a project and dilute the
  # one field whose job is grouping. Left empty, which drops the line and takes
  # the field out of the entry. `cwd` still records where the work happened.
}

# ---------------------------------------------------------------- arguments

# Bare `agent-journal` lists, because the question a person arrives with is what
# is in the journal, not how to ask. `--help` is still there for the other one.
if [ $# -eq 0 ]; then
  cmd=list
else
  case $1 in
    help | -h | --help) show_help ;;
    # A filter with no command in front of it is still a question about the
    # entries, so `aj --since 7d` reads the way it looks.
    -*) cmd=list ;;
    *)
      cmd=$1
      shift
      ;;
  esac
fi

cwd=
cwd_set=0
session_id=

date_filter=
since=
until=
project_filter=
limit=20
opt_summary=
summary_set=0
opt_body=
body_set=0

arg1=
arg2=
arg3=
argc=0

while [ $# -gt 0 ]; do
  case $1 in
    # One flag, two readings: for `context` it says where the session is, and for
    # the query commands it says which entries to keep. Each command below takes
    # the one it means.
    --cwd) [ $# -ge 2 ] || usage; cwd=$2; cwd_set=1; shift 2 ;;
    --cwd=*) cwd=${1#--cwd=}; cwd_set=1; shift ;;
    --session-id) [ $# -ge 2 ] || usage; session_id=$2; shift 2 ;;
    --session-id=*) session_id=${1#--session-id=}; shift ;;
    --date) [ $# -ge 2 ] || usage; date_filter=$2; shift 2 ;;
    --date=*) date_filter=${1#--date=}; shift ;;
    --since) [ $# -ge 2 ] || usage; since=$2; shift 2 ;;
    --since=*) since=${1#--since=}; shift ;;
    --until) [ $# -ge 2 ] || usage; until=$2; shift 2 ;;
    --until=*) until=${1#--until=}; shift ;;
    --project) [ $# -ge 2 ] || usage; project_filter=$2; shift 2 ;;
    --project=*) project_filter=${1#--project=}; shift ;;
    --limit) [ $# -ge 2 ] || usage; limit=$2; shift 2 ;;
    --limit=*) limit=${1#--limit=}; shift ;;
    --all) limit=0; shift ;;
    # One flag per field, rather than one flag for "the message". An entry is a
    # summary and a body, and a single `-m` cannot say which it meant. Spelled
    # out like every other flag here, none of which has a short form.
    --summary) [ $# -ge 2 ] || usage; opt_summary=$2; summary_set=1; shift 2 ;;
    --summary=*) opt_summary=${1#--summary=}; summary_set=1; shift ;;
    --body) [ $# -ge 2 ] || usage; opt_body=$2; body_set=1; shift 2 ;;
    --body=*) opt_body=${1#--body=}; body_set=1; shift ;;
    -h | --help) show_help ;;
    -*) usage ;;
    *)
      argc=$((argc + 1))
      case $argc in
        1) arg1=$1 ;;
        2) arg2=$1 ;;
        3) arg3=$1 ;;
        *) usage ;;
      esac
      shift
      ;;
  esac
done

case $limit in
  '' | *[!0-9]*) printf '%s: --limit takes a number\n' "$limit" >&2; exit 2 ;;
esac

[ -n "$cwd" ] || cwd=$PWD
# Entries record this path, and one that reads `.` records nothing at all. An
# adapter passes an absolute path, but a shell invocation is where the mistake
# would be made and it costs one line to make it impossible.
abs=$(cd "$cwd" 2>/dev/null && pwd) && cwd=$abs

read_config "$config_file"
journal_dir=$(expand_home "${cfg_journal_dir:-$default_journal_dir}")

# ---------------------------------------------------------------- config

if [ "$cmd" = config ]; then
  action=$arg1

  if [ -z "$action" ]; then
    # Effective value first, then where it came from, so the common question
    # ("what is it doing") is answered before the rarer one ("why").
    printf 'journal_dir=%s\n' "$journal_dir"
    printf 'journal_dir_from=%s\n' "$([ -n "$cfg_journal_dir" ] && echo config || echo default)"
    printf 'config_file=%s\n' "$config_file"
    exit 0
  fi

  case $action in
    set) [ "$argc" -ge 3 ] || usage; set_key=$arg2; set_value=$arg3 ;;
    unset) [ "$argc" -ge 2 ] || usage; set_key=$arg2; set_value= ;;
    *) usage ;;
  esac

  case $set_key in
    journal_dir) ;;
    *) printf '%s: not a setting\n' "$set_key" >&2; exit 2 ;;
  esac

  # Writing the default is the same as not having the key, and saying so is what
  # keeps the default free to change later.
  if [ -n "$set_value" ] && [ "$(expand_home "$set_value")" = "$default_journal_dir" ]; then
    set_value=
  fi

  write_config "$config_file" "$set_key" "$set_value" || exit 1

  # Created here rather than at session start, so the directory exists before
  # anything tries to write an entry into it and no hook has a side effect.
  read_config "$config_file"
  mkdir -p "$(expand_home "${cfg_journal_dir:-$default_journal_dir}")" || exit 1
  exit 0
fi

# ---------------------------------------------------------------- entries

# A day, from the three forms a person types. Absolute dates and `today` are
# free; `Nd` needs arithmetic, which POSIX `date` cannot do and the two
# implementations that can do it disagree about. Try both rather than pick one
# and be wrong on half the machines this runs on.
resolve_day() {
  case $1 in
    today) date -u +%Y-%m-%d ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) printf '%s\n' "$1" ;;
    *d)
      n=${1%d}
      case $n in
        '' | *[!0-9]*) return 1 ;;
      esac
      date -u -v-"${n}"d +%Y-%m-%d 2>/dev/null && return 0
      date -u -d "$n days ago" +%Y-%m-%d 2>/dev/null && return 0
      return 1
      ;;
    *) return 1 ;;
  esac
}

# One line per entry, out of the files it is given. `list` and `search` differ
# only in whether `query` is set, and `read` borrows it to show what an ambiguous
# id matched, so the format is defined once.
#
# Reads whole files rather than stopping at the frontmatter, because `nextfile`
# is not in POSIX awk and the entries are small: a year of them is a few
# megabytes, which is less than `grep` already crosses to answer the same
# question.
render() {
  awk \
    -v query="${query:-}" \
    -v project="$project_filter" \
    -v cwdf="$cwd_filter" \
    -v since="$since" \
    -v until="$until" \
    -v limit="$limit" \
    -v color="$color" \
    -v cols="$cols" '
    function emit(   day) {
      if (!had) return
      day = substr(stem, 1, 10)
      if (since != "" && day < since) return
      if (until != "" && day > until) return
      if (project != "" && proj != project) return
      if (cwdf != "" && index(dir, cwdf) != 1) return
      if (q != "" && index(tolower(summary " " body), q) == 0) return

      n++
      when[n] = day " " substr(stem, 12, 2) ":" substr(stem, 14, 2)
      who[n] = proj
      what[n] = summary
    }

    BEGIN { q = tolower(query) }

    FILENAME != cur {
      if (cur != "") emit()
      cur = FILENAME
      stem = FILENAME
      sub(/.*\//, "", stem)
      sub(/\.md$/, "", stem)
      fm = 0; had = 0; proj = ""; summary = ""; dir = ""; body = ""
    }

    FNR == 1 && $0 == "---" { fm = 1; had = 1; next }

    fm == 1 {
      if ($0 == "---") { fm = 2; next }
      line = $0
      if (sub(/^project:[ \t]*/, "", line)) { proj = line; next }
      if (sub(/^cwd:[ \t]*/, "", line)) { dir = line; next }
      if (sub(/^summary:[ \t]*/, "", line)) {
        # The one quoted field, and the quotes are punctuation rather than value.
        if (substr(line, 1, 1) == "\"") line = substr(line, 2)
        if (substr(line, length(line), 1) == "\"") line = substr(line, 1, length(line) - 1)
        summary = line
        next
      }
      next
    }

    q != "" { body = body " " $0 }

    END {
      emit()
      first = 1
      if (limit > 0 && n > limit) first = n - limit + 1

      # Measured over the rows that will be printed, not over everything that
      # matched: one long project name in January should not indent all of today.
      for (i = first; i <= n; i++)
        if (length(who[i]) > width) width = length(who[i])

      for (i = first; i <= n; i++) {
        pad = who[i]
        while (length(pad) < width) pad = pad " "
        text = what[i]
        # Only ever narrowed for a terminal. Down a pipe the summary stays whole,
        # so `list | grep` sees what `grep` on the entries would have seen.
        if (cols > 0) {
          room = cols - (length(when[i]) + 2 + width + 2)
          if (room > 4 && length(text) > room) text = substr(text, 1, room - 3) "…"
        }
        if (color)
          printf "\033[2m%s\033[0m  \033[36m%s\033[0m  %s\n", when[i], pad, text
        else
          printf "%s  %s  %s\n", when[i], pad, text
      }
    }
  ' "$@"
}

if [ "$cmd" = list ] || [ "$cmd" = search ] || [ "$cmd" = read ]; then
  # A prefix and a range are two ways to say the same thing, and honouring both
  # at once would quietly return the intersection nobody asked for.
  if [ -n "$date_filter" ] && { [ -n "$since" ] || [ -n "$until" ]; }; then
    printf 'use --date or --since/--until, not both\n' >&2
    exit 2
  fi

  # Through a second name, because assigning the substitution directly would
  # empty the variable before the failure branch could name what was wrong with
  # it.
  if [ -n "$since" ]; then
    day=$(resolve_day "$since") || {
      printf 'not a day: %s. Use YYYY-MM-DD, today, or 7d\n' "$since" >&2
      exit 2
    }
    since=$day
  fi
  if [ -n "$until" ]; then
    day=$(resolve_day "$until") || {
      printf 'not a day: %s. Use YYYY-MM-DD, today, or 7d\n' "$until" >&2
      exit 2
    }
    until=$day
  fi

  # Entries record `cwd` abbreviated, and a filter is compared against what is
  # written rather than what is on disk. `--cwd .` therefore means here.
  cwd_filter=
  [ "$cwd_set" = 0 ] || cwd_filter=$(abbrev_home "$cwd")

  color=0
  cols=0
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    color=1
    cols=$(tput cols 2>/dev/null) || cols=0
    case $cols in
      '' | *[!0-9]*) cols=0 ;;
    esac
  fi

  if [ ! -d "$journal_dir" ]; then
    printf 'no journal at %s\n' "$journal_dir" >&2
    exit 1
  fi
fi

if [ "$cmd" = list ] || [ "$cmd" = search ]; then
  query=
  if [ "$cmd" = search ]; then
    [ "$argc" -ge 1 ] || usage
    query=$arg1
  else
    [ "$argc" -eq 0 ] || usage
  fi

  # The filenames are the instant each entry records, so the shell's own ordering
  # is chronological and a `--date` prefix is a date range the glob applies for
  # free: the entries it excludes are never opened.
  #
  # Starting from the shape of an entry name matters. A journal directory is a
  # plain directory and often holds a README, which `*.md` would sweep up and
  # which sorts after every timestamp there will ever be.
  if [ -n "$date_filter" ]; then
    set -- "$journal_dir"/"$date_filter"*.md
  else
    set -- "$journal_dir"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T*.md
  fi

  # A glob only ever expands to names that exist, so the one case to rule out is
  # that it matched nothing and was left as its own pattern. Testing the first
  # argument settles it. Filtering the whole list instead would be quadratic:
  # each `set -- "$@" ...` copies every argument, which on a year of entries is
  # seconds of work to learn what the shell already guaranteed.
  if [ ! -f "$1" ]; then
    # An empty journal and a filter that excluded everything both print nothing,
    # and the difference between them is the difference between advice and noise.
    # Worth a second glob to tell them apart: silence on the first run of a new
    # install reads as something being broken.
    set -- "$journal_dir"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T*.md
    if [ ! -f "$1" ]; then
      printf 'no entries yet in %s\n' "$journal_dir" >&2
      printf 'your agent writes them on its own, or write one with: agent-journal write\n' >&2
    fi
    exit 0
  fi

  render "$@"
  exit 0
fi

# ---------------------------------------------------------------- read

if [ "$cmd" = read ]; then
  [ "$argc" -le 1 ] || usage
  id=$arg1
  [ -n "$id" ] || id=latest

  if [ "$id" = latest ]; then
    entry=
    for candidate in "$journal_dir"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T*.md; do
      [ -f "$candidate" ] || continue
      entry=$candidate
    done
    [ -n "$entry" ] || {
      printf 'no entries in %s\n' "$journal_dir" >&2
      exit 1
    }
    cat "$entry"
    exit 0
  fi

  matches=0
  entry=
  for candidate in "$journal_dir"/"$id"*.md; do
    [ -f "$candidate" ] || continue
    matches=$((matches + 1))
    entry=$candidate
  done

  if [ "$matches" = 0 ]; then
    printf 'no entry matches %s\n' "$id" >&2
    exit 1
  fi

  # Printing a guess would be the wrong answer more often than it would be right,
  # so an ambiguous id shows what it matched and lets the next attempt be exact.
  if [ "$matches" -gt 1 ]; then
    printf '%s matches %d entries:\n' "$id" "$matches" >&2
    query=
    limit=0
    render "$journal_dir"/"$id"*.md
    exit 1
  fi

  cat "$entry"
  exit 0
fi

# ---------------------------------------------------------------- write

if [ "$cmd" = write ]; then
  [ "$argc" -eq 0 ] || usage

  # The clock is read once and that one instant is both the filename and the
  # `date` field, which is the rule the instruction asks a model to follow by
  # hand. Here it is the only way it can happen.
  #
  # A name is one second wide, so two entries written in the same second want the
  # same one. Waiting for the next second keeps the filename the instant it
  # records, which every date filter and `read` prefix depends on; a suffix would
  # buy nothing and cost that.
  tries=0
  while :; do
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ) || exit 1
    stem=$(printf '%s' "$now" | tr -d ':')
    entry=$journal_dir/$stem.md

    [ -e "$entry" ] || break

    tries=$((tries + 1))
    [ "$tries" -le 3 ] || {
      printf 'an entry already exists for this second: %s\n' "$entry" >&2
      exit 1
    }
    sleep 1
  done

  # A value that would end its field early or split the line is refused rather
  # than escaped. The summary is quoted, so only a quote or a newline can break
  # it; the others are bare, where a colon ends the key as well.
  refuse_if_unquotable() {
    case $2 in
      *'"'* | *"$newline"*)
        printf 'the %s cannot contain a quote or a newline\n' "$1" >&2
        exit 2
        ;;
    esac
    [ "$3" = bare ] || return 0
    case $2 in
      *:*)
        printf 'the %s cannot contain a colon\n' "$1" >&2
        exit 2
        ;;
    esac
  }

  refuse_if_unquotable summary "$opt_summary" quoted
  refuse_if_unquotable project "$project_filter" bare
  refuse_if_unquotable 'session id' "$session_id" bare

  mkdir -p "$journal_dir" || exit 1

  resolve_project "$cwd"
  # Derived from where the session is, unless it was named. The same flag filters
  # the other commands, and here it says which project the entry belongs to.
  [ -z "$project_filter" ] || project=$project_filter

  summary=$opt_summary
  body=$opt_body

  # Anything piped in is the body. Always, and nothing else, so there is one
  # rule to remember rather than a table of which field a pipe lands in.
  #
  # Not read at all when --body already gave one, which is what stops
  # `--summary X --body Y` waiting on a pipe nobody is going to write to.
  if [ "$body_set" = 0 ] && [ ! -t 0 ]; then
    body=$(cat)
  fi

  while :; do
    case $body in
      "$newline"*) body=${body#"$newline"} ;;
      *) break ;;
    esac
  done

  # In a directory of its own, so the name can end in `.md` for the editor while
  # the path stays unguessable. A shared /tmp is somebody else's to write in too.
  draft_dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-journal-XXXXXX") || exit 1
  draft=$draft_dir/entry.md
  {
    printf -- '---\n'
    printf 'date: %s\n' "$now"
    [ -z "$project" ] || printf 'project: %s\n' "$project"
    printf 'summary: "%s"\n' "$summary"
    printf 'cwd: %s\n' "$(abbrev_home "$cwd")"
    [ -z "$session_id" ] || printf 'session_id: %s\n' "$session_id"
    printf -- '---\n\n'
  } > "$draft" || exit 1

  if [ "$summary_set" = 1 ]; then
    [ -z "$body" ] || printf '%s\n' "$body" >> "$draft"
  else
    # A terminal is only needed for the fallback to `vi`, which would fight for a
    # screen it has not got. An editor the caller named is the caller's business
    # and may well be a script.
    if [ -z "${VISUAL:-}" ] && [ -z "${EDITOR:-}" ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
      printf 'no summary. Use --summary, or run write with no arguments to open an editor\n' >&2
      rm -rf "$draft_dir"
      exit 2
    fi

    # The same idiom INSTRUCTIONS.md uses: guidance in a comment that the reader
    # strips, so the template is a valid entry and the note never survives it.
    cat >> "$draft" <<'EOF'
<!--
Fill in the summary between the quotes above: one line, at most 200 characters,
what happened and what it means rather than a topic.

Everything below is the body: what was decided, what was rejected and why, what
is still open. This comment goes away when you save.
-->

EOF

    # A body that arrived on a pipe or a flag goes in before the editor opens,
    # rather than being dropped for want of a summary to go with it.
    [ -z "$body" ] || printf '%s\n' "$body" >> "$draft"

    # Through a shell, so that `EDITOR="code -w"` works. An editor setting is a
    # command line rather than a program name, and every other tool that opens
    # one treats it that way.
    sh -c "${VISUAL:-${EDITOR:-vi}} \"\$1\"" sh "$draft" || {
      printf 'editor exited without saving, draft kept at %s\n' "$draft" >&2
      exit 1
    }

    stripped=$draft.stripped
    awk '
      fences < 2 { print; if ($0 == "---") fences++; next }
      comment { if (/-->/) comment = 0; next }
      /^<!--/ { comment = 1; next }
      # The blank lines the comment leaves behind are not the start of the body,
      # which begins one line after the frontmatter however much room the note
      # took up.
      !started && /^[ \t]*$/ { next }
      { if (!started) { started = 1; print "" } print }
    ' "$draft" > "$stripped" && mv "$stripped" "$draft"
  fi

  summary_line=$(awk '
    fm == 1 && sub(/^summary:[ \t]*/, "") { print; exit }
    $0 == "---" { fm = 1 }
  ' "$draft")

  reject() {
    printf '%s\n' "$1" >&2
    printf 'draft kept at %s\n' "$draft" >&2
    exit 1
  }

  case $summary_line in
    '"'*'"') ;;
    *) reject 'the summary must be wrapped in double quotes' ;;
  esac

  inner=${summary_line#\"}
  inner=${inner%\"}

  [ -n "$inner" ] || reject 'the summary is empty'
  [ "${#inner}" -le 200 ] ||
    reject "the summary is ${#inner} characters, and the limit is 200"

  mv "$draft" "$entry" || exit 1
  printf '%s\n' "$entry"
  exit 0
fi

[ "$cmd" = context ] || usage

# ---------------------------------------------------------------- context

instructions=$root/INSTRUCTIONS.md

# A missing file means nothing to say, which is not worth failing a session over.
# Print nothing and let the caller decide that means nothing to inject.
[ -n "$root" ] || exit 0
[ -f "$instructions" ] || exit 0

resolve_project "$cwd"

# INSTRUCTIONS.md is the whole of the injected text, placeholders and all, so
# that every word a session is given lives in one file a person can read. This is
# the only thing that renders it.
awk \
  -v journal_dir="$journal_dir" \
  -v project="$project" \
  -v cwd="$(abbrev_home "$cwd")" \
  -v session_id="$session_id" '
  BEGIN {
    keys = "journal_dir project cwd session_id"
    n = split(keys, key, " ")
    value["journal_dir"] = journal_dir
    value["project"] = project
    value["cwd"] = cwd
    value["session_id"] = session_id

    # In a gsub replacement `&` means the matched text and `\` escapes, so a
    # value containing either would substitute itself back in mangled.
    for (i = 1; i <= n; i++) gsub(/[\\&]/, "\\\\&", value[key[i]])
  }

  # The editing note the template carries for its human readers is not part of
  # what the session is told.
  NR == 1 && /^<!--/ { comment = 1 }
  comment { if (/-->/) comment = 0; next }
  # The blank lines the comment left behind are not the start of the text.
  !started && /^[ \t]*$/ { next }

  {
    started = 1
    line = $0
    for (i = 1; i <= n; i++) {
      placeholder = "__" toupper(key[i]) "__"
      if (!index(line, placeholder)) continue
      # A value the adapter could not supply takes its whole line with it,
      # rather than leaving a label with nothing after it.
      if (value[key[i]] == "") next
      gsub(placeholder, value[key[i]], line)
    }
    print line
  }
' "$instructions"

