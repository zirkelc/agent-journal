        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/adapters/codex/session-start.sh",
            "statusMessage": "Reading the journal instruction",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
